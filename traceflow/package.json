{
  "name": "apetit-traceflow",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.ts",
    "dev:web": "vite",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.ts",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "import:challenge": "node --disable-warning=ExperimentalWarning scripts/import-challenge.ts",
    "benchmark": "node --disable-warning=ExperimentalWarning scripts/benchmark.ts",
    "fixtures": "node --disable-warning=ExperimentalWarning scripts/make-demo-fixtures.ts",
    "sample": "node --disable-warning=ExperimentalWarning scripts/sample-workbook.ts",
    "nature:build": "python3 nature_model/tools/check_environment.py && python3 nature_model/tools/build_nature_model.py && python3 nature_model/tools/check_environment.py --verify-existing",
    "nature:test": "python3 -m unittest discover -s nature_model/tools -p 'test_*.py'",
    "start:api": "node --disable-warning=ExperimentalWarning server/index.ts",
    "demo:share": "node --disable-warning=ExperimentalWarning scripts/share-demo.ts",
    "demo:stop": "node --disable-warning=ExperimentalWarning scripts/share-demo.ts --stop",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./tsconfig.server.json && tsc -p ./jsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'tests/unit/**/*.test.ts' 'tests/api/**/*.test.ts'",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'tests/e2e/**/*.test.ts'",
    "preview": "vite preview"
  },
  "dependencies": {
