# Local TraceFlow configuration. Copy to .env and fill in only what you need.
# Secrets (API keys) are read by the backend only and are never sent to the browser.
API_HOST=127.0.0.1
API_PORT=8787
VITE_API_BASE=/api
SQLITE_PATH=./data/traceflow.sqlite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_AI_INVESTIGATION=true
AUTO_REVIEW_IMPORTS=true
# Review each newly saved inventory calculation for findings and suggested next steps.
# At most four AI wording requests per discovery run, if Gemini is configured; otherwise local.
DISCOVERY_AFTER_CALCULATION=true
ROUTING_PROVIDER=provided_distance
HERE_API_KEY=
# Optional local OCR. Install Tesseract and poppler-utils; defaults search PATH and data/tools/.
OCR_LANGUAGES=eng
# TESSERACT_PATH=/usr/bin/tesseract
# PDFTOPPM_PATH=/usr/bin/pdftoppm
# Same-network access (off by default). The API stays on 127.0.0.1; Vite opens to the local network.
# No code or login: anyone on the network can use the app (and your Gemini key).
LAN_ACCESS=false
# Nature model (Python + SQLite in nature_model/). Defaults work from this folder.
# NATURE_MODEL_DIR=./nature_model
# NATURE_SQLITE_PATH=./nature_model/analysis/nature/nature.sqlite
# PYTHON_PATH=python3
# APETIT_DATA_DIR=../APETIT_CLIMATE_NATURE_NAVIGATOR_2026/data
# NATURE_JOB_TIMEOUT_MIN=20
